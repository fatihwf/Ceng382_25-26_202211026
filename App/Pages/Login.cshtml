@page
@model App.Pages.LoginModel

<h2>Login</h2>

<form method="post">
    <div>
        <label for="Username">Kullanıcı Adı: </label>
        <input type="text" id="Username" name="Username" asp-for="Username" />
    </div>
    <div>
        <label for="Password">Şifre: </label>
        <input type="password" id="Password" name="Password" asp-for="Password" />
    </div>
    <div>
        <button type="submit">Giriş Yap</button>
    </div>
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div style="color:red;">@Model.ErrorMessage</div>
    }
</form>
