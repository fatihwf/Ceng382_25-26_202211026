@page
@model App.Pages.TableModel
@using App.Models
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

<h2>Class Management</h2>

<div class="container">
    <div class="row">
        <!-- Left Side: Form -->
        <div class="col-md-6">
            <form method="post">
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="Filter" />
                <input type="hidden" asp-for="PageNumber" />

                <div class="form-group">
                    <label asp-for="ClassName"></label>
                    <input asp-for="ClassName" class="form-control" />
                    <span asp-validation-for="ClassName" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="StudentCount"></label>
                    <input asp-for="StudentCount" type="number" class="form-control" />
                    <span asp-validation-for="StudentCount" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Description"></label>
                    <textarea asp-for="Description" class="form-control"></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>

                @if (!Model.IsEditMode)
                {
                    <button type="submit" asp-page-handler="Add" class="btn btn-primary">Add Class</button>
                }
                else
                {
                    <button type="submit" asp-page-handler="Update" class="btn btn-secondary">Update Class</button>
                    <button type="submit" asp-page-handler="Cancel" class="btn btn-danger">Cancel</button>
                }
            </form>
        </div>

        <!-- Right Side: Table with Filtering, Export and Pagination -->
        <div class="col-md-6">
            <!-- Üst satır: Filter form ve Export JSON butonu -->
            <div class="d-flex justify-content-between mb-3">
                <form method="get" class="form-inline">
                    <div class="form-group">
                        <label for="Filter" class="mr-2">Filter by Name:</label>
                        <input type="text" class="form-control" name="Filter" value="@Model.Filter" placeholder="Enter name" />
                    </div>
                    <button type="submit" class="btn btn-primary ml-2">Filter</button>
                </form>
                <form method="post" id="columnSelectForm">
                    <input type="hidden" id="selectedColumnsInput" name="selectedColumns" value="[]" />
                    <button asp-page-handler="Export" type="submit" class="btn btn-success">Export JSON</button>
                </form>
            </div>

            <!-- Tablo -->
            <table class="table table-bordered">
                <thead>
                    <tr>
                        <th data-column="Id">Id</th>
                        <th data-column="Name">Name</th>
                        <th data-column="PersonCount">Person Count</th>
                        <th data-column="Description">Description</th>
                        <th data-column="IsActive">Is Active</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.ClassList)
                    {
                        <tr>
                            <td data-column="Id">@item.Id</td>
                            <td data-column="Name">@item.Name</td>
                            <td data-column="PersonCount">@item.PersonCount</td>
                            <td data-column="Description">@item.Description</td>
                            <td data-column="IsActive">@(item.IsActive ? "Yes" : "No")</td>
                            <td>
                                <form method="post" class="d-inline">
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <button type="submit" asp-page-handler="Edit" class="btn btn-warning">Edit</button>
                                </form>
                                <form method="post" class="d-inline">
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <button type="submit" asp-page-handler="Delete" class="btn btn-danger">Delete</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            <!-- Pagination Controls -->
            <nav aria-label="Page navigation">
                <ul class="pagination justify-content-center">
                    <li class="page-item @(Model.PageNumber <= 1 ? "disabled" : "")">
                        <a class="page-link"
                           asp-page="Table"
                           asp-route-PageNumber="@(Model.PageNumber - 1)"
                           asp-route-Filter="@Model.Filter">
                            Previous
                        </a>
                    </li>
                    @for (int i = 1; i <= Model.TotalPages; i++)
                    {
                        <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                            <a class="page-link"
                               asp-page="Table"
                               asp-route-PageNumber="@i"
                               asp-route-Filter="@Model.Filter">
                                @i
                            </a>
                        </li>
                    }
                    <li class="page-item @(Model.PageNumber >= Model.TotalPages ? "disabled" : "")">
                        <a class="page-link"
                           asp-page="Table"
                           asp-route-PageNumber="@(Model.PageNumber + 1)"
                           asp-route-Filter="@Model.Filter">
                            Next
                        </a>
                    </li>
                </ul>
            </nav>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

<style>
    .highlight-column {
        background-color: lightblue !important;
        font-weight: bold;
    }
    input[type="checkbox"]:checked + label {
        color: blue;
        font-weight: bold;
    }
</style>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const headers = document.querySelectorAll("th[data-column]");
        let selectedColumns = [];

        headers.forEach(header => {
            header.addEventListener("click", function () {
                const columnName = this.getAttribute("data-column");
                const columnCells = document.querySelectorAll(`[data-column='${columnName}']`);

                // Toggle selection
                if (selectedColumns.includes(columnName)) {
                    selectedColumns = selectedColumns.filter(col => col !== columnName);
                } else {
                    selectedColumns.push(columnName);
                }

                // Toggle highlight
                columnCells.forEach(cell => cell.classList.toggle("highlight-column"));
                this.classList.toggle("highlight-column");

                // Update hidden input field with selected columns
                document.getElementById("selectedColumnsInput").value = JSON.stringify(selectedColumns);
            });
        });
    });
</script>
